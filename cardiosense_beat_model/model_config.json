      "epochs": 15,
      "batch": 512,
      "lr": 0.001,
      "wd": 0.001,
      "cw_power": 0.5,
      "label_smoothing": 0.05,
      "swa_epochs": 5
    },
    "seeds": [
      42,
      43,
      44
    ]
  },
