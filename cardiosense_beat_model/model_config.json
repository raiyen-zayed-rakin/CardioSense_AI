{
  "model_version": "cardiosense-beat-resnet-tpl-20261117",
  "architecture": "ResNet1D, 2-channel input (beat, beat minus patient template) + 7 RR features; 3-seed ensemble, SWA weights, softmax-averaged",
  "files": {
    "torchscript": "beat_model_ts.pt",
    "state_dict": "beat_model.pth",
    "onnx": "beat_model.onnx"
  },
  "model_class": "cardiosense_beats.ResNet1D(use_rr=True, in_ch=2, w=32), wrapped in cardiosense_beats.BeatEnsemble",
  "ensemble_size": 3,
  "classes": [
    "N",
    "S",
    "V",
    "F"
  ],
  "fs": 250,
  "pre": 90,
  "post": 160,
  "margin": 8,
  "window_len": 250,
  "bandpass_hz": [
    0.5,
    40.0
  ],
  "filter_order": 3,
  "template_prev_beats": 20,
  "rr_features": [
    "pre_rr",
    "post_rr",
    "local10_rr",
    "pre/local10",
    "post/local10",
    "pre/post",
    "pre/local100"
  ],
  "rr_transform": "log(clip(x, 0.01, 10)), RR in seconds, causal local means",
  "inputs": {
    "beat": "(B, 2, 250) float32",
    "rr": "(B, 7) float32"
  },
  "output": "(B, 4) class probabilities",
  "unknown_threshold": 0.5,
  "class_bias": [
    0,
    0,
    0,
    0
  ],
  "latency_note": "post_rr needs the next beat, so each label is available ~1 beat after the R-peak",
  "training": {
    "deployment_data": "MIT-BIH 44 non-paced records + INCART 75 records",
    "augmentation": "R-peak jitter +-32 ms, NSTDB em/ma/bw noise at 6-30 dB SNR",
